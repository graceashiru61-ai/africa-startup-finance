---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section>
				<p>Startup Finance for Africa</p>

				<h1>Financial Modeling for African Startups</h1>

				<p>
					Build a clear, investor-ready financial model for your startup.
					Understand your revenue, costs, runway, funding needs, and growth
					scenarios before making major decisions.
				</p>

				<p>
					I help African founders turn their business assumptions into
					practical financial models for fundraising and business planning.
				</p>

				<a href="/contact/">Get Your Financial Model Built</a>
			</section>

			<section>
				<h2>Financial Modeling Services</h2>

				<ul>
					<li>Startup financial models</li>
					<li>Revenue and expense forecasting</li>
					<li>Cash flow and runway planning</li>
					<li>Fundraising scenarios</li>
					<li>Unit economics</li>
					<li>Financial model reviews</li>
				</ul>
			</section>

			<section>
				<h2>African Startup Finance Insights</h2>

				<p>
					Read practical insights about startup finance, fundraising,
					financial modeling, and funding developments across Africa.
				</p>

				<a href="/blog/">Read the latest insights →</a>
			</section>
		</main>

		<Footer />
	</body>
</html>