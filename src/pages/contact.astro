---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Contact | Africa Startup Finance"
			description={SITE_DESCRIPTION}
		/>
	</head>

	<body>
		<Header />

		<main>
			<section>
				<h1>Build Your Startup Financial Model</h1>

				<p>
					Need help building a financial model for your startup?
					I help African founders create practical models for planning,
					fundraising, and growth decisions.
				</p>
			</section>

			<section>
				<h2>Request a Consultation</h2>

				<p>
					Tell me about your startup and your financial modeling needs.
					I will review your information and get back to you with the next steps.
				</p>

				<iframe
					src="https://tally.so/embed/Bzyb2N?alignLeft=1&hideTitle=1&transparentBackground=1"
					width="100%"
					height="800"
					frameborder="0"
					marginheight="0"
					marginwidth="0"
					title="Financial Modeling Consultation Request">
				</iframe>
			</section>

			<section>
				<h2>Get In Touch</h2>

				<p>
					Email:
					<a href="mailto:udokanzemeke@gmail.com">
						udokanzemeke@gmail.com
					</a>
				</p>

				<p>
					I will respond with the next steps for your financial modeling project.
				</p>
			</section>
		</main>

		<Footer />
	</body>
</html>