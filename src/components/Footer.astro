---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<h2>Africa Startup Finance</h2>

			<p>
				Practical financial modeling, startup finance, and insights
				for founders.
			</p>

			<a class="footer-email" href="mailto:udokanzemeke@gmail.com">
				udokanzemeke@gmail.com
			</a>
		</div>

		<div class="footer-navigation">
			<h3>Explore</h3>

			<div class="footer-links">
				<a href="/">Home</a>
				<a href="/financial-modeling/">Financial Modeling</a>
				<a href="/blog/">Insights</a>
				<a href="/about/">About</a>
				<a href="/contact/">Contact</a>
			</div>
		</div>
	</div>

	<div class="footer-bottom">
		<p>
			&copy; {today.getFullYear()} Africa Startup Finance. All rights reserved.
		</p>
	</div>
</footer>

<style>
	footer {
		margin-top: 4rem;
		padding: 3.5rem 1.5rem 2rem;

		background: #0f172a;
		color: #cbd5e1;

		border-top: 5px solid #0f766e;
	}

	.footer-inner {
		max-width: 1100px;
		margin: 0 auto;

		display: flex;
		justify-content: space-between;

		gap: 4rem;
		flex-wrap: wrap;
	}

	.footer-brand {
		max-width: 520px;
	}

	.footer-brand h2 {
		margin-top: 0;
		margin-bottom: 0.75rem;

		color: #ffffff;
		font-size: 1.7rem;
	}

	.footer-brand p {
		color: #cbd5e1;
	}

	.footer-email {
		color: #5eead4;
		text-decoration: none;
		font-weight: 700;
	}

	.footer-email:hover {
		color: #99f6e4;
		text-decoration: underline;
	}

	.footer-navigation h3 {
		color: #ffffff;
		margin-top: 0;
		margin-bottom: 1rem;
		font-size: 1rem;
	}

	.footer-links {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	.footer-links a {
		color: #cbd5e1;
		text-decoration: none;
	}

	.footer-links a:hover {
		color: #5eead4;
	}

	.footer-bottom {
		max-width: 1100px;
		margin: 2.5rem auto 0;

		padding-top: 1.5rem;

		border-top: 1px solid #334155;

		font-size: 0.9rem;
		color: #94a3b8;
	}

	.footer-bottom p {
		margin: 0;
	}

	@media (max-width: 700px) {
		.footer-inner {
			flex-direction: column;
			gap: 2rem;
		}
	}
</style>