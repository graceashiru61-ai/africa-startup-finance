---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<h2>Africa Startup Finance</h2>

			<p>
				Practical financial modeling, startup finance, and insights
				for founders.
			</p>

			<a href="mailto:africastartupfinance@gmail.com">
				africastartupfinance@gmail.com
			</a>
		</div>

		<div class="footer-links">
			<a href="/">Home</a>
			<a href="/financial-modeling/">Financial Modeling</a>
			<a href="/blog/">Insights</a>
			<a href="/about/">About</a>
			<a href="/contact/">Contact</a>
		</div>
	</div>

	<div class="footer-bottom">
		<p>
			&copy; {today.getFullYear()} Africa Startup Finance. All rights reserved.
		</p>
	</div>
</footer>

<style>
	footer {
		margin-top: 4rem;
		padding: 3rem 1.5rem 2rem;
		background: #f8fafc;
		border-top: 1px solid #e5e7eb;
		color: #374151;
	}

	.footer-inner {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		gap: 3rem;
		flex-wrap: wrap;
	}

	.footer-brand {
		max-width: 500px;
	}

	.footer-brand h2 {
		margin-top: 0;
		color: #111827;
	}

	.footer-brand a {
		color: #111827;
		text-decoration: none;
		font-weight: 600;
	}

	.footer-links {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.footer-links a {
		color: #374151;
		text-decoration: none;
	}

	.footer-links a:hover,
	.footer-brand a:hover {
		text-decoration: underline;
	}

	.footer-bottom {
		max-width: 1100px;
		margin: 2rem auto 0;
		padding-top: 1.5rem;
		border-top: 1px solid #e5e7eb;
		font-size: 0.9rem;
	}

	@media (max-width: 700px) {
		.footer-inner {
			flex-direction: column;
		}
	}
</style>