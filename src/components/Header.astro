---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a class="site-title" href="/">{SITE_TITLE}</a>

		<div class="internal-links">
			<a href="/">Home</a>
			<a href="/financial-modeling/">Financial Modeling</a>
			<a href="/blog/">Insights</a>
			<a href="/about/">About</a>
			<a href="/contact/" class="contact-link">Contact</a>
		</div>
	</nav>
</header>

<style>
	header {
		background: #0f172a;
		border-bottom: 4px solid #0f766e;
		box-shadow: 0 4px 16px rgba(15, 23, 42, 0.12);
	}

	nav {
		max-width: 1100px;
		margin: 0 auto;
		padding: 1.1rem 1.5rem;

		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.site-title {
		font-size: 1.3rem;
		font-weight: 800;
		text-decoration: none;
		color: #ffffff;
		white-space: nowrap;
	}

	.site-title:hover {
		color: #5eead4;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.4rem;
		flex-wrap: wrap;
	}

	.internal-links a {
		text-decoration: none;
		color: #e2e8f0;
		font-weight: 600;
		font-size: 0.95rem;
	}

	.internal-links a:hover {
		color: #5eead4;
	}

	.contact-link {
		background: #0f766e;
		color: #ffffff !important;
		padding: 0.55rem 0.9rem;
		border-radius: 8px;
	}

	.contact-link:hover {
		background: #14b8a6;
		color: #ffffff !important;
	}

	@media (max-width: 800px) {
		nav {
			flex-direction: column;
			align-items: flex-start;
		}

		.internal-links {
			gap: 0.8rem 1rem;
		}
	}
</style>