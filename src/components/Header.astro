---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a class="site-title" href="/">{SITE_TITLE}</a>

		<div class="internal-links">
			<a href="/">Home</a>
			<a href="/financial-modeling/">Financial Modeling</a>
			<a href="/blog/">Insights</a>
			<a href="/about/">About</a>
			<a href="/contact/">Contact</a>
		</div>
	</nav>
</header>

<style>
	header {
		background: white;
		border-bottom: 1px solid #e5e7eb;
	}

	nav {
		max-width: 1100px;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.site-title {
		font-size: 1.2rem;
		font-weight: 700;
		text-decoration: none;
		color: #111827;
		white-space: nowrap;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		flex-wrap: wrap;
	}

	.internal-links a {
		text-decoration: none;
		color: #374151;
		font-weight: 500;
	}

	.internal-links a:hover {
		color: #111827;
	}

	@media (max-width: 800px) {
		nav {
			flex-direction: column;
			align-items: flex-start;
		}

		.internal-links {
			gap: 0.8rem 1rem;
		}
	}
</style>